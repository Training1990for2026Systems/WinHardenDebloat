# WHD Next - never commit PC-specific data
logs/
inventory/
restore/
archive/
publish/
reports/
profiles/incoming/
profiles/*.bak
*.log
REPORT.txt

# third-party block lists (other people's data - not ours to publish)
profiles/blacklist-*.txt
