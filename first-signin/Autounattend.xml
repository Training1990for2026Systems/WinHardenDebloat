<?xml version="1.0" encoding="utf-8"?>
<!--
  WHD USB Image - answer file for Windows Setup. Written by hand; own text.
  When part first-signin is on, the build script copies this file into the image as
  Windows\Panther\unattend.xml. Microsoft Learn ("Replace the answer file in an offline image") names
  that place: Windows Setup finds the file there and uses it. It is NOT put on the root of the stick any
  more: in WHD's test install of 2026-10-08, Setup found the file there and passed it over.

  It does ONE thing: at the first sign-in of the first user it starts the script that the build
  script copied into the image (Windows\Setup\Scripts\WHD-FirstSignIn.ps1). -FromSetup only makes the
  script write into its log that Windows Setup started it.
  It answers no Setup question: language, edition, disk and account are still asked on screen.

  Microsoft Learn: Microsoft-Windows-Shell-Setup | FirstLogonCommands (pass oobeSystem). The command
  runs once, after logon, with administrator rights when the first user is an administrator.
  processorArchitecture is amd64: this file is for a 64-bit (x64) Windows image.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <FirstLogonCommands>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>cmd.exe /c powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%SystemRoot%\Setup\Scripts\WHD-FirstSignIn.ps1" -FromSetup</CommandLine>
                    <Description>WHD USB Image - first sign-in script</Description>
                    <Order>1</Order>
                </SynchronousCommand>
            </FirstLogonCommands>
        </component>
    </settings>
</unattend>
